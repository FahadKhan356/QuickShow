# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored - never commit real secrets.

# Display currency symbol
VITE_CURRENCY=$

# Clerk Publishable Key (public - safe to share)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Backend API base URL (local dev uses vite proxy -> http://localhost:3000/api)
# For production deployment, set this to your deployed backend URL, e.g. https://<your-api-domain>/api
VITE_API_BASE_URL=/api